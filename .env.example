# ─────────────────────────────────────────────
# DoctorNex Infra — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# ─────────────────────────────────────────────

# MySQL root (solo para administración interna del contenedor)
MYSQL_ROOT_PASSWORD=root

# Usuario de la aplicación (todos los MSV usan este usuario)
MYSQL_USER=doctornex
MYSQL_PASSWORD=doctornex
